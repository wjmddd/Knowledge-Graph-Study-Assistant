# ==========================================
# 环境变量配置模板
# 复制此文件为 .env 并填入你的配置
# ==========================================

# ---------- LLM 配置 ----------
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- Neo4j 配置 ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

